<?xml version="1.0"?>

<robot name="sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="sensor_name" value="ultrasonic" />
    <xacro:property name="mass" value="0.1" />

    <!-- Used for fixing robot to Gazebo 'base_link' -->
    <link name="world"/>


    <joint name="fixed" type="fixed">
        <parent link="world"/>
        <child link="${sensor_name}_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>
  
    <!-- ultrasound Link -->
    <link name="${sensor_name}_link">
        <collision>
            <origin xyz="0 0 0.0" rpy="1.57 0 0"/>
            <geometry>
                <box size="0.05 0.1 0.1"/> 
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0.0" rpy="1.57 0 0"/>
            <geometry>
                <box size="0.05 0.1 0.1"/> 
            </geometry>
            <material name="orange"/>
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia ixx="${mass}" ixy="0.0" ixz="0.0" iyy="${mass}" iyz="0.0" izz="${mass}"/>
        </inertial>
    </link>
  
    <material name="orange">
        <color rgba="${255/255} ${108/255} ${10/255} 1.0"/>
    </material>
  
    <!-- Gazebo Sim has no Range sensor: a narrow 5x5-ray lidar models the
         ultrasonic cone; the ultrasonic_range node turns it into sensor_msgs/Range -->
    <gazebo reference="${sensor_name}_link">
        <sensor type="gpu_lidar" name="head_${sensor_name}_sensor">
            <pose>0 0 0 0 0 0</pose>
            <topic>${sensor_name}/scan</topic>
            <frame_id>${sensor_name}_link</frame_id>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>40</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>5</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.157</min_angle>
                        <max_angle>0.157</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>5</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-0.157</min_angle>
                        <max_angle>0.157</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.10</min>
                    <max>1.3</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>
