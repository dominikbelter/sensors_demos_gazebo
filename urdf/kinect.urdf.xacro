<?xml version="1.0"?>

<robot name="sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="sensor_name" value="kinect" />
    <xacro:property name="height1" value="1.2" />
    <xacro:property name="height2" value="0.5" />
    <xacro:property name="width" value="0.2" />
    <xacro:property name="mass" value="0.1" />
    <!-- Used for fixing robot to Gazebo 'base_link' -->
    <link name="world"/>


    <joint name="fixed" type="fixed">
        <parent link="world"/>
        <child link="${sensor_name}_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>
  
    <!-- Kinect Link -->
    <link name="${sensor_name}_link">
        <collision>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find sensors_demos_gazebo)/meshes/kinect.dae" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(find sensors_demos_gazebo)/meshes/kinect.dae" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="orange"/>
        </visual>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}"/>
            <inertia ixx="${mass}" ixy="0.0" ixz="0.0" iyy="${mass}" iyz="0.0" izz="${mass}"/>
        </inertial>
    </link>
  
    <link name="${sensor_name}_optical_link">
    <!--<visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.01 0.01 0.01"/>
            </geometry>
            <material name="orange"/>
        </visual>-->
    </link>
  
    <joint name="optical_joint" type="fixed">
        <parent link="${sensor_name}_link"/>
        <child link="${sensor_name}_optical_link"/>
        <origin xyz="0.01 0 0.15" rpy="0.0 0 0"/>
    </joint>
  
    <material name="orange">
        <color rgba="${255/255} ${108/255} ${10/255} 1.0"/>
    </material>
    <!-- RGB-D camera; Gazebo publishes <topic>/image, /depth_image, /points,
         /camera_info. The launch file bridges and remaps them to the
         realsense-style names used before (kinect/color/image_raw, ...). -->
    <gazebo reference="${sensor_name}_optical_link">
        <sensor type="rgbd_camera" name="${sensor_name}_depth_sensor">
            <topic>${sensor_name}</topic>
            <frame_id>${sensor_name}_optical_link</frame_id>
            <always_on>true</always_on>
            <update_rate>1</update_rate>
            <camera name="${sensor_name}">
                <horizontal_fov>${91.2*pi/180}</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>4.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>
</robot>
